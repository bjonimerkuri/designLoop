{
  "name": "@designloop/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "demo:export": "node dist/scripts/export-demo.js",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "prisma:push": "dotenv -e ../../.env -- prisma db push"
  },
  "dependencies": {
    "@designloop/agent-core": "*",
    "@designloop/shared": "*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "^6.0.0",
    "@sentry/node": "^8.40.0",
    "dotenv": "^16.4.0",
    "pg-boss": "^10.1.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.0",
    "@types/multer": "^1.4.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/supertest": "^6.0.0",
    "dotenv-cli": "^7.4.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "typescript": "^5.6.0"
  }
}
